<Window x:Class="중간프로젝트_클라이언트.MenuDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="메뉴 상세"
        Width="520" Height="720"
        MinWidth="440" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Malgun Gothic">

    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CFEBFF" Offset="0"/>
            <GradientStop Color="#EEF8FF" Offset="0.45"/>
            <GradientStop Color="#F6FBF4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B9BEA"/>
        <SolidColorBrush x:Key="PrimaryDark"  Color="#2B84CF"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"     Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"      Color="#5F7A93"/>
        <SolidColorBrush x:Key="LineBrush"    Color="#DCE8F3"/>
        <SolidColorBrush x:Key="HeartBrush"   Color="#E5484D"/>

        <!-- 카드 공통 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#3B9BEA" BlurRadius="22" ShadowDepth="3" Opacity="0.10"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ♥ 좋아요 토글 버튼 -->
        <Style x:Key="LikeToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="44"/>
            <Setter Property="Padding" Value="18,0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource HeartBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="bd"
                                Background="White"
                                BorderBrush="#F6B8BA" BorderThickness="1.5"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock x:Name="heart" Text="♡" FontSize="20"
                                           VerticalAlignment="Center" Margin="0,-2,8,0"/>
                                <TextBlock x:Name="label" Text="좋아요" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFF1F1"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource HeartBrush}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource HeartBrush}"/>
                                <Setter TargetName="heart" Property="Text" Value="♥"/>
                                <Setter TargetName="label" Property="Text" Value="좋아요 취소"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 등록 버튼 -->
        <Style x:Key="SendButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="72"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource PrimaryBrush}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B5D6F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 코멘트 입력칸 -->
        <Style x:Key="CommentBoxStyle" TargetType="TextBox">
            <Setter Property="MinHeight" Value="42"/>
            <Setter Property="MaxHeight" Value="90"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="AcceptsReturn" Value="False"/>
            <Setter Property="VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="#F6FAFE"
                                BorderBrush="#DCE8F3" BorderThickness="1"
                                CornerRadius="10">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 내 코멘트 삭제 X 버튼 -->
        <Style x:Key="DeleteButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="22"/>
            <Setter Property="Height" Value="22"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTip" Value="내 코멘트 삭제"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="11">
                            <TextBlock x:Name="x" Text="✕" FontSize="11"
                                       Foreground="#A9BCCD"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FDECEC"/>
                                <Setter TargetName="x" Property="Foreground" Value="{StaticResource HeartBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Opacity" Value="0.4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 코멘트 한 줄 -->
        <DataTemplate x:Key="CommentTemplate">
            <Border Padding="0,12" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 프로필 동그라미 (이름 첫 글자) -->
                    <Border x:Name="avatar"
                            Width="36" Height="36" CornerRadius="18"
                            Background="{StaticResource PrimaryLight}"
                            VerticalAlignment="Top" Margin="0,0,12,0">
                        <TextBlock x:Name="avatarText"
                                   Text="{Binding Initial, FallbackValue=익}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Grid.Column="1">
                        <DockPanel>
                            <!-- 오른쪽 : 작성 시간 + (내 코멘트만) X 버튼 -->
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CreatedAtText}"
                                           FontSize="11"
                                           Foreground="{StaticResource TextSub}"
                                           VerticalAlignment="Center"/>
                                <Button Style="{StaticResource DeleteButtonStyle}"
                                        Margin="6,0,0,0"
                                        Visibility="{Binding IsMine, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.DeleteCommentCommand,
                                                  RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Writer}"
                                           FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource TextMain}"
                                           VerticalAlignment="Center"/>
                                <!-- 구분 배지 (학생 / 학부모 / 영양사) -->
                                <Border x:Name="roleBadge"
                                        Margin="6,0,0,0" Padding="6,1"
                                        CornerRadius="6"
                                        Background="#EEF4FA"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="roleText"
                                               Text="{Binding Role}"
                                               FontSize="10"
                                               Foreground="{StaticResource TextSub}"/>
                                </Border>
                            </StackPanel>
                        </DockPanel>

                        <TextBlock Text="{Binding Content}"
                                   Margin="0,5,0,0"
                                   FontSize="13" LineHeight="20"
                                   TextWrapping="Wrap"
                                   Foreground="#3A4A5C"/>
                    </StackPanel>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- 영양사 코멘트는 초록색으로 눈에 띄게 -->
                <DataTrigger Binding="{Binding Role}" Value="영양사">
                    <Setter TargetName="roleBadge" Property="Background" Value="#DCFCE7"/>
                    <Setter TargetName="roleText" Property="Foreground" Value="#15803D"/>
                    <Setter TargetName="avatar" Property="Background" Value="#DCFCE7"/>
                    <Setter TargetName="avatarText" Property="Foreground" Value="#15803D"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding Role}" Value="학부모">
                    <Setter TargetName="roleBadge" Property="Background" Value="#FEF3C7"/>
                    <Setter TargetName="roleText" Property="Foreground" Value="#B45309"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid Margin="22,20,22,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 메뉴 정보 + 좋아요 -->
            <RowDefinition Height="*"/>
            <!-- 코멘트 목록 -->
            <RowDefinition Height="Auto"/>
            <!-- 코멘트 입력 -->
        </Grid.RowDefinitions>

        <!-- ===== 1. 메뉴 정보 카드 ===== -->
        <Border Grid.Row="0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <!-- 날짜 · 끼니 -->
                <StackPanel Orientation="Horizontal">
                    <Border Background="{StaticResource PrimaryLight}" CornerRadius="8" Padding="10,4">
                        <TextBlock Text="{Binding MealTypeText, FallbackValue=☀️ 중식}"
                                   FontSize="12" FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="{Binding DateText, FallbackValue=2026년 11월 5일 (목)}"
                               Margin="10,0,0,0"
                               FontSize="13"
                               Foreground="{StaticResource TextSub}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 메뉴 목록 (칩 형태) -->
                <ItemsControl ItemsSource="{Binding MenuItems}" Margin="0,14,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,6,6" Padding="10,5"
                                    Background="#F0F7FD" CornerRadius="14">
                                <TextBlock Text="{Binding}" FontSize="13"
                                           Foreground="{StaticResource TextMain}"/>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <TextBlock Text="{Binding Calories, StringFormat='{}{0} kcal', FallbackValue=812 kcal}"
                           FontSize="12"
                           Foreground="{StaticResource TextSub}"
                           Margin="0,4,0,0"/>

                <!-- 구분선 -->
                <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,16"/>

                <!-- 좋아요 -->
                <DockPanel>
                    <ToggleButton DockPanel.Dock="Right"
                                  Style="{StaticResource LikeToggleStyle}"
                                  IsChecked="{Binding IsLiked, Mode=TwoWay}"
                                  Command="{Binding LikeCommand}"/>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="♥" FontSize="22"
                                       Foreground="{StaticResource HeartBrush}"
                                       VerticalAlignment="Center" Margin="0,-2,8,0"/>
                            <TextBlock Text="{Binding LikeCount, FallbackValue=0}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="명이 이 메뉴를 좋아해요"
                                   FontSize="12"
                                   Foreground="{StaticResource TextSub}"
                                   Margin="0,2,0,0"/>
                    </StackPanel>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- ===== 2. 코멘트 목록 ===== -->
        <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,14,0,14" Padding="20,16,12,8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                    <TextBlock Text="💬 코멘트" FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="{Binding Comments.Count, FallbackValue=0}"
                               Margin="6,0,0,0"
                               FontSize="15" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                    <ItemsControl ItemsSource="{Binding Comments}"
                                  ItemTemplate="{StaticResource CommentTemplate}"/>
                </ScrollViewer>

                <!-- 코멘트가 없을 때 -->
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Comments.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Text="🍽️" FontSize="32" HorizontalAlignment="Center"/>
                    <TextBlock Text="아직 코멘트가 없어요"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextSub}"
                               HorizontalAlignment="Center" Margin="0,8,0,2"/>
                    <TextBlock Text="첫 번째 코멘트를 남겨보세요!"
                               FontSize="12"
                               Foreground="#A9BCCD"
                               HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== 3. 코멘트 입력 ===== -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Grid>
                <TextBox x:Name="TxtComment"
                         Style="{StaticResource CommentBoxStyle}"
                         MaxLength="200"
                         Text="{Binding NewCommentText, UpdateSourceTrigger=PropertyChanged}"/>
                <!-- 안내 문구 (비어 있을 때만 보임) -->
                <TextBlock Text="이 메뉴 어땠나요? 한마디 남겨주세요"
                           Margin="14,0,0,0"
                           VerticalAlignment="Center"
                           FontSize="13"
                           Foreground="#A9BCCD"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=TxtComment}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <!-- Enter 키로도 등록 -->
            <Button Grid.Column="1"
                    x:Name="BtnSendComment"
                    Content="등록"
                    IsDefault="True"
                    Margin="8,0,0,0"
                    VerticalAlignment="Bottom"
                    Style="{StaticResource SendButtonStyle}"
                    Command="{Binding AddCommentCommand}"/>
        </Grid>
    </Grid>
</Window>
