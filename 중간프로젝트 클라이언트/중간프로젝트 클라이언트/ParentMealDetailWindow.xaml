<Window x:Class="중간프로젝트_클라이언트.ParentMealDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="급식 상세"
        Width="580" Height="780"
        MinWidth="480" MinHeight="560"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FontFamily="Malgun Gothic">

    <!-- ===== 공통 하늘색 파스텔 배경 ===== -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CFEBFF" Offset="0"/>
            <GradientStop Color="#EEF8FF" Offset="0.45"/>
            <GradientStop Color="#F6FBF4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="Accent"      Color="#3B9BEA"/>
        <SolidColorBrush x:Key="AccentDark"  Color="#2B84CF"/>
        <SolidColorBrush x:Key="AccentLight" Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"    Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"     Color="#5F7A93"/>
        <SolidColorBrush x:Key="LineBrush"   Color="#DCE8F3"/>

        <DropShadowEffect x:Key="CardShadow" Color="#3B9BEA" BlurRadius="22" ShadowDepth="3" Opacity="0.10"/>

        <!-- 카드 -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="18"/>
            <Setter Property="Padding" Value="20,18"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="Effect" Value="{StaticResource CardShadow}"/>
        </Style>

        <!-- 카드 제목 -->
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- 정보 없음 안내 -->
        <Style x:Key="EmptyText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#A9BCCD"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,8"/>
        </Style>

        <!-- 닫기 버튼 -->
        <Style x:Key="CloseButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Accent}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B9BEA" BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="24,22,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- 제목 -->
            <RowDefinition Height="*"/>     <!-- 내용 (스크롤) -->
            <RowDefinition Height="Auto"/>  <!-- 닫기 -->
        </Grid.RowDefinitions>

        <!-- ===== 제목 ===== -->
        <StackPanel Grid.Row="0" Margin="2,0,0,16">
            <StackPanel Orientation="Horizontal">
                <Border Background="#CCFFFFFF" CornerRadius="12" Padding="10,4"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1">
                    <TextBlock Text="{Binding MealTypeText, FallbackValue=☀️ 중식}"
                               FontSize="12" FontWeight="Bold"
                               Foreground="{StaticResource AccentDark}"/>
                </Border>
                <TextBlock Text="불러오는 중…" Margin="10,0,0,0"
                           FontSize="12" Foreground="{StaticResource TextSub}"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
            <TextBlock Text="{Binding TitleText, FallbackValue=11월 5일 (목) 중식}"
                       FontSize="26" FontWeight="Bold"
                       Foreground="{StaticResource TextMain}"
                       Margin="0,10,0,0"/>
            <TextBlock Text="{Binding SchoolName, FallbackValue=가수원중학교}"
                       FontSize="13" Foreground="{StaticResource TextSub}"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- ===== 내용 ===== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,6,0">
            <StackPanel Margin="0,0,0,4">

                <!-- 칼로리 / 급식 인원 -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="White" CornerRadius="18" Padding="18,16"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="🔥 칼로리" FontSize="12" Foreground="{StaticResource TextSub}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                <TextBlock Text="{Binding CaloriesNumber, FallbackValue=812.3}"
                                           FontSize="26" FontWeight="Bold"
                                           Foreground="#E8590C"/>
                                <TextBlock Text=" kcal" FontSize="14"
                                           Foreground="{StaticResource TextSub}"
                                           VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Background="White" CornerRadius="18" Padding="18,16"
                            Effect="{StaticResource CardShadow}">
                        <StackPanel>
                            <TextBlock Text="👥 급식 인원" FontSize="12" Foreground="{StaticResource TextSub}"/>
                            <TextBlock Text="{Binding MealCountText, FallbackValue=812명}"
                                       FontSize="26" FontWeight="Bold"
                                       Foreground="{StaticResource AccentDark}"
                                       Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 메뉴 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🍽️ 메뉴" Style="{StaticResource CardTitle}"/>
                        <ItemsControl ItemsSource="{Binding MenuLines}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,8">
                                        <Border DockPanel.Dock="Left"
                                                Width="24" Height="24" CornerRadius="12"
                                                Background="{StaticResource AccentLight}"
                                                Margin="0,0,10,0">
                                            <TextBlock Text="{Binding No}" FontSize="11" FontWeight="Bold"
                                                       Foreground="{StaticResource AccentDark}"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding Name}" FontSize="14"
                                                   Foreground="{StaticResource TextMain}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- 영양 정보 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="📊 영양 정보" Style="{StaticResource CardTitle}"/>

                        <ItemsControl ItemsSource="{Binding Nutrition}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="3"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="4" Padding="12,10"
                                            Background="#F4F9FE" CornerRadius="12">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontSize="12"
                                                       Foreground="{StaticResource TextSub}"
                                                       TextTrimming="CharacterEllipsis"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                <TextBlock Text="{Binding Value}" FontSize="16" FontWeight="Bold"
                                                           Foreground="{StaticResource TextMain}"/>
                                                <TextBlock Text="{Binding Unit}" FontSize="11"
                                                           Foreground="{StaticResource TextSub}"
                                                           VerticalAlignment="Bottom" Margin="3,0,0,2"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="영양 정보가 없어요">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasNutrition}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- 원산지 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="🌾 원산지 정보" Style="{StaticResource CardTitle}"/>

                        <ItemsControl ItemsSource="{Binding Origins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="2,9" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1">
                                        <DockPanel>
                                            <Border x:Name="badge" DockPanel.Dock="Right"
                                                    CornerRadius="10" Padding="10,3"
                                                    Background="#FFF4E5">
                                                <TextBlock x:Name="badgeText" Text="{Binding Value}"
                                                           FontSize="12" FontWeight="SemiBold"
                                                           Foreground="#C2410C"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}" FontSize="13"
                                                       Foreground="{StaticResource TextMain}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"/>
                                        </DockPanel>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <!-- 국내산은 초록색 -->
                                        <DataTrigger Binding="{Binding IsDomestic}" Value="True">
                                            <Setter TargetName="badge" Property="Background" Value="#DCFCE7"/>
                                            <Setter TargetName="badgeText" Property="Foreground" Value="#15803D"/>
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="원산지 정보가 없어요">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyText}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOrigins}" Value="False">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== 닫기 ===== -->
        <Button Grid.Row="2"
                Margin="0,14,0,0"
                Style="{StaticResource CloseButtonStyle}"
                Content="닫기"
                IsCancel="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
