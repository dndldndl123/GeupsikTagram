<Window x:Class="중간프로젝트_클라이언트.HoomWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="급식타그램"
        Width="900" Height="950"
        MinWidth="900" MinHeight="950"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic">

    <!-- ===== 공통 하늘색 파스텔 배경 ===== -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CFEBFF" Offset="0"/>
            <GradientStop Color="#EEF8FF" Offset="0.45"/>
            <GradientStop Color="#F6FBF4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- ===== 공통 색상 (4개 창 동일) ===== -->
        <SolidColorBrush x:Key="Accent"      Color="#3B9BEA"/>
        <SolidColorBrush x:Key="AccentDark"  Color="#2B84CF"/>
        <SolidColorBrush x:Key="AccentLight" Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"    Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"     Color="#5F7A93"/>
        <SolidColorBrush x:Key="LineBrush"   Color="#DCE8F3"/>

        <!-- 카드 그림자 -->
        <DropShadowEffect x:Key="CardShadow" Color="#3B9BEA" BlurRadius="24" ShadowDepth="3" Opacity="0.10"/>

        <!-- 메뉴 카드 버튼 -->
        <Style x:Key="MenuCardStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="25"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="CardBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="Transparent" BorderThickness="2"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}"
                                Effect="{StaticResource CardShadow}">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="CardBorder" Property="Background" Value="#F4FAFF"/>
                                <Setter TargetName="CardBorder" Property="BorderBrush" Value="#B5D6F2"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="CardBorder" Property="Opacity" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- 오늘의 급식 : 메뉴 한 줄 (점심) -->
        <DataTemplate x:Key="LunchMenuItem">
            <DockPanel Margin="0,0,0,9">
                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#3B9BEA"
                         VerticalAlignment="Center" Margin="2,0,10,0"/>
                <TextBlock Text="{Binding}" FontSize="14.5"
                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>

        <!-- 오늘의 급식 : 메뉴 한 줄 (저녁) -->
        <DataTemplate x:Key="DinnerMenuItem">
            <DockPanel Margin="0,0,0,9">
                <Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#7C5CE0"
                         VerticalAlignment="Center" Margin="2,0,10,0"/>
                <TextBlock Text="{Binding}" FontSize="14.5"
                           Foreground="{StaticResource TextMain}" TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- 배경 장식 -->
        <TextBlock Text="🌤️"
                   FontSize="140" Opacity="0.15"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-10,40,0"
                   Foreground="{StaticResource TextMain}"
                   IsHitTestVisible="False"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="55,35,55,40">

                <!-- ===== 상단 헤더 ===== -->
                <Grid Margin="0,0,0,30">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal">
                        <Border Width="52" Height="52" CornerRadius="16"
                                Background="White" Margin="0,0,14,0"
                                Effect="{StaticResource CardShadow}">
                            <TextBlock Text="🍚" FontSize="26"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <!-- 학교명 -->
                            <TextBlock x:Name="TxtHeaderSchool"
                                         Text="OO고등학교"
                                         FontSize="22" FontWeight="Bold"
                                         Foreground="{StaticResource TextMain}"/>
                            <!-- 이름 · 구분 -->
                            <TextBlock x:Name="TxtHeaderUser"
                                         Text="홍길동 · 학생"
                                         FontSize="13"
                                         Foreground="{StaticResource TextSub}"
                                         Margin="1,4,0,0"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
        Content="로그아웃"
        Click="BtnLogout_Click"
        Cursor="Hand"
        VerticalAlignment="Center"
        FontSize="13" FontWeight="SemiBold"
        Foreground="{StaticResource AccentDark}">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd"
                    Background="#CCFFFFFF"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="20"
                    Padding="16,9">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="White"/>
                                        <Setter TargetName="bd" Property="BorderBrush" Value="#B5D6F2"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True">
                                        <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <!-- ===== 오늘의 급식 (점심 + 저녁) ===== -->
                <Border Background="White"
                        CornerRadius="22"
                        Padding="25"
                        Margin="0,0,0,30"
                        Effect="{StaticResource CardShadow}">
                    <StackPanel>
                        <!-- 제목 -->
                        <DockPanel Margin="5,0,5,18">
                            <TextBlock x:Name="TxtTodayDate"
                                       DockPanel.Dock="Right"
                                       Text="11월 6일 (금)"
                                       FontSize="14" FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSub}"
                                       VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            <StackPanel>
                                <Border Background="{StaticResource AccentLight}"
                                        CornerRadius="8" Padding="10,4"
                                        HorizontalAlignment="Left">
                                    <TextBlock Text="TODAY'S MEAL"
                                               FontSize="11" FontWeight="Bold"
                                               Foreground="{StaticResource AccentDark}"/>
                                </Border>
                                <TextBlock Text="🍽 오늘의 급식"
                                           FontSize="27" FontWeight="Bold"
                                           Foreground="{StaticResource TextMain}"
                                           Margin="0,12,0,0"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- 점심 / 저녁 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- 점심 -->
                            <Border Grid.Column="0"
                                    Background="#F3F9FF"
                                    BorderBrush="#DCEBF8" BorderThickness="1"
                                    CornerRadius="18" Padding="20,18"
                                    MinHeight="230">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border x:Name="LunchCaloriesBadge"
                                                DockPanel.Dock="Right"
                                                Background="White" CornerRadius="10" Padding="9,3"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtLunchCalories" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="☀️" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="점심" FontSize="18" FontWeight="Bold"
                                                       Foreground="#2B84CF"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Height="1" Background="#DCEBF8" Margin="0,0,0,14"/>

                                    <ItemsControl x:Name="LunchMenuList"
                                                  ItemTemplate="{StaticResource LunchMenuItem}"/>
                                    <TextBlock x:Name="TxtLunchEmpty"
                                               Text="급식 정보를 불러오는 중…"
                                               FontSize="13" Foreground="#A9BCCD"
                                               TextWrapping="Wrap" Margin="2,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <!-- 저녁 -->
                            <Border Grid.Column="2"
                                    Background="#F7F4FF"
                                    BorderBrush="#E6DFFA" BorderThickness="1"
                                    CornerRadius="18" Padding="20,18"
                                    MinHeight="230">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,14">
                                        <Border x:Name="DinnerCaloriesBadge"
                                                DockPanel.Dock="Right"
                                                Background="White" CornerRadius="10" Padding="9,3"
                                                VerticalAlignment="Center" Visibility="Collapsed">
                                            <TextBlock x:Name="TxtDinnerCalories" FontSize="11"
                                                       Foreground="{StaticResource TextSub}"/>
                                        </Border>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🌙" FontSize="18" VerticalAlignment="Center"/>
                                            <TextBlock Text="저녁" FontSize="18" FontWeight="Bold"
                                                       Foreground="#6A4FD0"
                                                       VerticalAlignment="Center" Margin="8,0,0,0"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Height="1" Background="#E6DFFA" Margin="0,0,0,14"/>

                                    <ItemsControl x:Name="DinnerMenuList"
                                                  ItemTemplate="{StaticResource DinnerMenuItem}"/>
                                    <TextBlock x:Name="TxtDinnerEmpty"
                                               Text="급식 정보를 불러오는 중…"
                                               FontSize="13" Foreground="#A9BCCD"
                                               TextWrapping="Wrap" Margin="2,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- ===== 하단 메뉴 제목 ===== -->
                <StackPanel Margin="0,0,0,18">
                    <TextBlock Text="급식 둘러보기"
                               FontSize="24" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="원하는 메뉴를 선택해 보세요."
                               FontSize="13"
                               Foreground="{StaticResource TextSub}"
                               Margin="0,6,0,0"/>
                </StackPanel>

                <!-- ===== 인기 메뉴 / 전체 식단 ===== -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 인기 메뉴 -->
                    <Button x:Name="BtnPopularMeals"
                            Grid.Column="0"
                            Style="{StaticResource MenuCardStyle}"
                            Height="260">
                        <StackPanel>
                            <Border Background="#FFF4D6"
                                    CornerRadius="18"
                                    Height="125"
                                    Margin="0,0,0,18">
                                <TextBlock Text="🏆" FontSize="65"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="🔥 인기 메뉴"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="학생들이 가장 좋아하는 급식 메뉴를 확인해 보세요."
                                       FontSize="13"
                                       Foreground="{StaticResource TextSub}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="인기 메뉴 보러가기  →"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,15,0,0"/>
                        </StackPanel>
                    </Button>

                    <!-- 전체 식단 -->
                    <Button x:Name="BtnAllMeals"
                            Grid.Column="2"
                            Style="{StaticResource MenuCardStyle}"
                            Height="260">
                        <StackPanel>
                            <Border Background="{StaticResource AccentLight}"
                                    CornerRadius="18"
                                    Height="125"
                                    Margin="0,0,0,18">
                                <TextBlock Text="📅" FontSize="65"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="전체 식단"
                                       FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextMain}"/>
                            <TextBlock Text="우리 학교의 월별 급식 일정과 메뉴를 확인해 보세요."
                                       FontSize="13"
                                       Foreground="{StaticResource TextSub}"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"/>
                            <TextBlock Text="전체 식단 보러가기  →"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="{StaticResource Accent}"
                                       Margin="0,15,0,0"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- 하단 문구 -->
                <TextBlock Text="급식타그램 · 우리 학교의 맛있는 이야기"
                           FontSize="11"
                           Foreground="{StaticResource TextSub}"
                           HorizontalAlignment="Center"
                           Margin="0,30,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
