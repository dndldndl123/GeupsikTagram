<Window x:Class="중간프로젝트_클라이언트.AlertWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알림"
        Width="350" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <Border Background="White"
            CornerRadius="20"
            BorderBrush="#E3E6EE"
            BorderThickness="1"
            Padding="25">

        <Border.Effect>
            <DropShadowEffect BlurRadius="20"
                              ShadowDepth="3"
                              Opacity="0.15"/>
        </Border.Effect>

        <StackPanel VerticalAlignment="Center">

            <TextBlock x:Name="TxtIcon"
                       Text="⚠️"
                       FontSize="38"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock x:Name="TxtTitle"
                       Text="오류"
                       FontSize="21"
                       FontWeight="Bold"
                       Foreground="#333333"
                       HorizontalAlignment="Center"/>

            <TextBlock x:Name="TxtMessage"
                       Text="입력 정보를 확인해주세요."
                       FontSize="13"
                       Foreground="#777777"
                       TextWrapping="Wrap"
                       TextAlignment="Center"
                       Margin="0,12,0,22"/>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="ColCancel" Width="0"/>
                    <!-- 평소엔 0 → 취소 버튼 안 보임 -->
                    <ColumnDefinition x:Name="ColGap" Width="0"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 취소 (확인 창일 때만 보임) -->
                <Button x:Name="BtnCancel"
            Grid.Column="0"
            Content="취소"
            Height="42"
            Background="#EEF2F7"
            Foreground="#5F7A93"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            Visibility="Collapsed"
            Click="BtnCancel_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- 확인 -->
                <Button x:Name="BtnConfirm"
            Grid.Column="2"
            Content="확인"
            Height="42"
            Background="#3B9BEA"
            Foreground="White"
            FontWeight="Bold"
            BorderThickness="0"
            Cursor="Hand"
            Click="BtnConfirm_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="BtnBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="BtnBorder" Property="RenderTransform">
                                        <Setter.Value>
                                            <TranslateTransform Y="2"/>
                                        </Setter.Value>
                                    </Setter>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>