<Window x:Class="중간프로젝트_클라이언트.StudentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="급식타그램"
        Width="1180" Height="920"
        MinWidth="900" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6FA"
        FontFamily="Malgun Gothic">

    <Window.Resources>
        <!-- ===== 색상 ===== -->
        <SolidColorBrush x:Key="PrimaryBrush"   Color="#3B9BEA"/>
        <SolidColorBrush x:Key="PrimaryLight"   Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"       Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"        Color="#5F7A93"/>
        <SolidColorBrush x:Key="BorderBrush"    Color="#DCE8F3"/>
        <SolidColorBrush x:Key="SundayBrush"    Color="#E5484D"/>
        <SolidColorBrush x:Key="SaturdayBrush"  Color="#3B82F6"/>

        <!-- ===== 이전/다음 달 버튼 ===== -->
        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 이달의 급식 버튼 ===== -->
        <Style x:Key="TopMenuButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#8A5A00"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd"
                                Background="#FFF4D6"
                                BorderBrush="#F5C451"
                                BorderThickness="1"
                                CornerRadius="18"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FFE7A3"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.75"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 조식/중식/석식 세그먼트 버튼 =====
             선택됐을 때 색은 각 버튼의 Tag(브러시)를 사용 → 끼니마다 다른 색 -->
        <Style x:Key="MealTabStyle" TargetType="RadioButton">
            <Setter Property="GroupName" Value="MealType"/>
            <Setter Property="Width" Value="92"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextSub}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Margin="2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F7FD"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="bd" Property="Background"
                                        Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 요일 헤더 텍스트 ===== -->
        <Style x:Key="WeekdayHeaderStyle" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- ===== 날짜 칸 하나 (DayItem 템플릿) =====
             윗줄 : 날짜 · 오늘 · (오른쪽) ♥ 좋아요 · 칼로리
             아래 : 메뉴를 작은 칩으로 줄바꿈 배치 → 칸이 넓은 만큼 한 줄에 2~3개씩 들어감
             칸에 다 안 들어가면 마우스를 올렸을 때 전체 메뉴가 툴팁으로 나옴 -->
        <DataTemplate x:Key="DayCellTemplate">
            <Border x:Name="cell"
                    Margin="4"
                    Padding="9,7"
                    Cursor="Hand"
                    MouseLeftButtonUp="DayCell_Click"
                    Background="White"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    ToolTip="{Binding Menu}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 윗줄 -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <TextBlock x:Name="dayText"
                                   DockPanel.Dock="Left"
                                   Text="{Binding Day}"
                                   FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}"
                                   VerticalAlignment="Center"/>
                        <Border x:Name="todayBadge"
                                DockPanel.Dock="Left"
                                Margin="6,0,0,0"
                                Background="{StaticResource PrimaryBrush}"
                                CornerRadius="6" Padding="6,1"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                            <TextBlock Text="오늘" FontSize="10" Foreground="White"/>
                        </Border>

                        <StackPanel x:Name="bottomRow"
                                    DockPanel.Dock="Right"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <TextBlock x:Name="likeText"
                                       Text="{Binding Likes, StringFormat='♥ {0}', FallbackValue='♥ 0'}"
                                       FontSize="11" FontWeight="SemiBold"
                                       Foreground="#E5484D">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Likes}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <TextBlock x:Name="calText"
                                       Text="{Binding Calories, StringFormat={}{0} kcal}"
                                       Margin="8,0,0,0"
                                       FontSize="11"
                                       Foreground="{StaticResource TextSub}"/>
                        </StackPanel>
                    </DockPanel>

                    <!-- 메뉴 (칩) -->
                    <ItemsControl x:Name="menuList"
                                  Grid.Row="1"
                                  Margin="0,6,0,0"
                                  ItemsSource="{Binding MenuItems}"
                                  ClipToBounds="True"
                                  Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,3,3" Padding="6,1"
                                        Background="#F0F7FD" CornerRadius="6">
                                    <TextBlock Text="{Binding}" FontSize="11.5"
                                               Foreground="#3A4A5C"/>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 급식 없는 날 문구 -->
                    <TextBlock x:Name="noMealText"
                               Grid.Row="1"
                               Margin="0,6,0,0"
                               Text="급식 없음"
                               FontSize="12"
                               Foreground="#B8BDCA"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <!-- 오늘 강조 -->
                <DataTrigger Binding="{Binding IsToday}" Value="True">
                    <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="cell" Property="BorderThickness" Value="2"/>
                    <Setter TargetName="cell" Property="Background" Value="#F2F9FF"/>
                    <Setter TargetName="todayBadge" Property="Visibility" Value="Visible"/>
                </DataTrigger>

                <!-- 마우스 올리면 살짝 강조 (급식이 있는 이번 달 날짜만) -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, ElementName=cell}" Value="True"/>
                        <Condition Binding="{Binding HasMeal}" Value="True"/>
                        <Condition Binding="{Binding IsCurrentMonth}" Value="True"/>
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="cell" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                    <Setter TargetName="cell" Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="#3B9BEA" BlurRadius="12" ShadowDepth="0" Opacity="0.25"/>
                        </Setter.Value>
                    </Setter>
                </MultiDataTrigger>

                <!-- 급식 없는 날 (클릭 안 되게) -->
                <DataTrigger Binding="{Binding HasMeal}" Value="False">
                    <Setter TargetName="menuList" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="noMealText" Property="Visibility" Value="Visible"/>
                    <Setter TargetName="bottomRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="cell" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="cell" Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>

                <!-- 이번 달이 아닌 날 (앞뒤 빈칸 채움용) -->
                <DataTrigger Binding="{Binding IsCurrentMonth}" Value="False">
                    <Setter TargetName="cell" Property="Background" Value="#66FFFFFF"/>
                    <Setter TargetName="cell" Property="BorderBrush" Value="Transparent"/>
                    <Setter TargetName="cell" Property="Opacity" Value="0.45"/>
                    <Setter TargetName="menuList" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="noMealText" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="bottomRow" Property="Visibility" Value="Collapsed"/>
                    <Setter TargetName="cell" Property="Cursor" Value="Arrow"/>
                    <Setter TargetName="cell" Property="ToolTip" Value="{x:Null}"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <!-- ================================================================
             끼니별 테마
             조식/중식/석식 버튼(RbBreakfast / RbLunch / RbDinner)의 IsChecked를
             보고 XAML만으로 배경·글자색·이모티콘·인사말이 바뀝니다.
             (기본값 = 중식)
             ================================================================ -->

        <!-- 테마 색 보관용 (화면에는 안 보임) : 다른 요소들이 이 Foreground를 가져다 씀 -->
        <TextBlock x:Name="ThemeMain" Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#22252E"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbBreakfast}" Value="True">
                            <Setter Property="Foreground" Value="#4A2E12"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbDinner}" Value="True">
                            <Setter Property="Foreground" Value="White"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock x:Name="ThemeSub" Visibility="Collapsed">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Foreground" Value="#5F7A93"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbBreakfast}" Value="True">
                            <Setter Property="Foreground" Value="#A0703A"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbDinner}" Value="True">
                            <Setter Property="Foreground" Value="#C4BEEA"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 배경 그라데이션 -->
        <Border>
            <Border.Style>
                <Style TargetType="Border">
                    <!-- 중식 : 맑은 하늘 -->
                    <Setter Property="Background">
                        <Setter.Value>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Color="#CFEBFF" Offset="0"/>
                                <GradientStop Color="#EEF8FF" Offset="0.45"/>
                                <GradientStop Color="#F6FBF4" Offset="1"/>
                            </LinearGradientBrush>
                        </Setter.Value>
                    </Setter>
                    <Style.Triggers>
                        <!-- 조식 : 해 뜨는 새벽 -->
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbBreakfast}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFD9A8" Offset="0"/>
                                        <GradientStop Color="#FFEBD2" Offset="0.45"/>
                                        <GradientStop Color="#FFF8EE" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                        <!-- 석식 : 별이 뜬 밤 -->
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbDinner}" Value="True">
                            <Setter Property="Background">
                                <Setter.Value>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#1B1F4B" Offset="0"/>
                                        <GradientStop Color="#33306A" Offset="0.5"/>
                                        <GradientStop Color="#4C3D7D" Offset="1"/>
                                    </LinearGradientBrush>
                                </Setter.Value>
                            </Setter>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>

        <!-- 배경 장식 : 오른쪽 위에 크게 흐릿한 이모티콘 -->
        <TextBlock HorizontalAlignment="Right" VerticalAlignment="Top"
                   Margin="0,-12,740,0"
                   FontSize="120" Opacity="0.18"
                   IsHitTestVisible="False"
                   Foreground="{Binding Foreground, ElementName=ThemeMain}">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Text" Value="🌤️"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbBreakfast}" Value="True">
                            <Setter Property="Text" Value="🌅"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbDinner}" Value="True">
                            <Setter Property="Text" Value="🌙"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <!-- 석식일 때만 보이는 별 장식 -->
        <Canvas IsHitTestVisible="False">
            <Canvas.Style>
                <Style TargetType="Canvas">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsChecked, ElementName=RbDinner}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Canvas.Style>
            <TextBlock Text="✦" Foreground="#FFF6C7" FontSize="14" Opacity="0.8" Canvas.Left="300" Canvas.Top="18"/>
            <TextBlock Text="✧" Foreground="#FFF6C7" FontSize="11" Opacity="0.6" Canvas.Left="420" Canvas.Top="58"/>
            <TextBlock Text="✦" Foreground="#FFF6C7" FontSize="9"  Opacity="0.7" Canvas.Left="560" Canvas.Top="14"/>
            <TextBlock Text="✧" Foreground="#FFF6C7" FontSize="16" Opacity="0.5" Canvas.Left="700" Canvas.Top="40"/>
            <TextBlock Text="✦" Foreground="#FFF6C7" FontSize="10" Opacity="0.8" Canvas.Left="820" Canvas.Top="10"/>
            <TextBlock Text="✧" Foreground="#FFF6C7" FontSize="12" Opacity="0.6" Canvas.Left="250" Canvas.Top="90"/>
        </Canvas>

        <!-- ================= 실제 화면 내용 ================= -->
        <Grid Margin="28,20,28,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 학교/이름 -->
                <RowDefinition Height="Auto"/>
                <!-- 인사말 + 월 이동 + 식사 선택 -->
                <RowDefinition Height="Auto"/>
                <!-- 요일 헤더 -->
                <RowDefinition Height="*"/>
                <!-- 달력 그리드 -->
            </Grid.RowDefinitions>

            <!-- ===== 1. 왼쪽 상단: 학교명 / 내 이름 + 오른쪽 상단: 이달의 급식 ===== -->
            <StackPanel Grid.Row="0"
            Orientation="Horizontal"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">

                <!-- 이달의 급식 (기존 버튼 그대로, Grid.Row / HorizontalAlignment 만 뺌) -->
                <Button x:Name="BtnTopMenu"
            Style="{StaticResource TopMenuButtonStyle}"
            VerticalAlignment="Center"
            ToolTip="이번 달 좋아요 TOP 3 메뉴 보기"
            Click="TopMenuButton_Click">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🏆" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="이달의 급식" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <!-- 로그아웃 -->
                <Button Content="로그아웃"
            Click="BtnLogout_Click"
            Margin="8,0,0,0"
            Height="36" Padding="14,0"
            FontSize="13" FontWeight="SemiBold"
            Foreground="{StaticResource TextSub}"
            Cursor="Hand"
            VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="bd"
                        Background="#CCFFFFFF"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="18"
                        Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="bd" Property="Background" Value="White"/>
                                    <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Border Width="28" Height="28" CornerRadius="14"
                        Background="#CCFFFFFF" Margin="0,0,10,0">
                    <TextBlock Text="🍱" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{Binding SchoolName, FallbackValue=OO고등학교}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{Binding Foreground, ElementName=ThemeMain}"/>
                    <TextBlock Text="{Binding UserName, FallbackValue=홍길동}"
                               FontSize="11"
                               Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
                </StackPanel>
            </StackPanel>

            <!-- ===== 2. 인사말 (왼쪽) + 월 이동 (가운데) + 조식/중식/석식 (오른쪽) ===== -->
            <Grid Grid.Row="1" Margin="0,14,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 끼니별 인사말 -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center"/>
                </StackPanel>

                <!-- 저번달 / 현재 월 / 다음달 -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="◀"
                            ToolTip="저번 달"
                            Command="{Binding PrevMonthCommand}"/>
                    <TextBlock Text="{Binding CurrentMonthText, FallbackValue=2026년 11월}"
                               MinWidth="180"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="16,0"
                               FontSize="26" FontWeight="Bold"
                               Foreground="{Binding Foreground, ElementName=ThemeMain}"/>
                    <Button Style="{StaticResource NavButtonStyle}"
                            Content="▶"
                            ToolTip="다음 달"
                            Command="{Binding NextMonthCommand}"/>
                </StackPanel>

                <!-- 조식 / 중식 / 석식 (Tag = 선택됐을 때 버튼 색) -->
                <Border Grid.Column="2"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Background="White"
                        BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                        CornerRadius="10" Padding="2">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbBreakfast"
                                     Style="{StaticResource MealTabStyle}"
                                     Content="🌅 조식"
                                     Command="{Binding ChangeMealCommand}"
                                     CommandParameter="Breakfast">
                            <RadioButton.Tag>
                                <SolidColorBrush Color="#F59E0B"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="RbLunch"
                                     Style="{StaticResource MealTabStyle}"
                                     Content="☀️ 중식"
                                     IsChecked="True"
                                     Command="{Binding ChangeMealCommand}"
                                     CommandParameter="Lunch">
                            <RadioButton.Tag>
                                <SolidColorBrush Color="#3B9BEA"/>
                            </RadioButton.Tag>
                        </RadioButton>
                        <RadioButton x:Name="RbDinner"
                                     Style="{StaticResource MealTabStyle}"
                                     Content="🌙 석식"
                                     Command="{Binding ChangeMealCommand}"
                                     CommandParameter="Dinner">
                            <RadioButton.Tag>
                                <SolidColorBrush Color="#7C5CE0"/>
                            </RadioButton.Tag>
                        </RadioButton>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- ===== 3. 요일 헤더 (평일만) ===== -->
            <UniformGrid Grid.Row="2" Columns="5" Height="32" Margin="0,0,0,4">
                <TextBlock Text="월" Style="{StaticResource WeekdayHeaderStyle}" Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
                <TextBlock Text="화" Style="{StaticResource WeekdayHeaderStyle}" Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
                <TextBlock Text="수" Style="{StaticResource WeekdayHeaderStyle}" Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
                <TextBlock Text="목" Style="{StaticResource WeekdayHeaderStyle}" Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
                <TextBlock Text="금" Style="{StaticResource WeekdayHeaderStyle}" Foreground="{Binding Foreground, ElementName=ThemeSub}"/>
            </UniformGrid>

            <!-- ===== 4. 이번 달 급식 그리드 (평일 5열 x 5주) ===== -->
            <Border Grid.Row="3"
                    Background="#59FFFFFF"
                    BorderBrush="#80FFFFFF" BorderThickness="1"
                    CornerRadius="14" Padding="6">
                <ItemsControl ItemsSource="{Binding Days}"
                              ItemTemplate="{StaticResource DayCellTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" Rows="5"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </Border>
        </Grid>
    </Grid>
</Window>
