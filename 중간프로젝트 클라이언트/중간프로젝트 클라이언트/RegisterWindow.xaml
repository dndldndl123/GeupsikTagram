<Window x:Class="중간프로젝트_클라이언트.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="회원가입" Height="790" Width="420"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Malgun Gothic">

    <!-- ===== 공통 하늘색 파스텔 배경 ===== -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CFEBFF" Offset="0"/>
            <GradientStop Color="#EEF8FF" Offset="0.45"/>
            <GradientStop Color="#F6FBF4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <SolidColorBrush x:Key="PrimaryBrush" Color="#3B9BEA"/>
        <SolidColorBrush x:Key="PrimaryDark"  Color="#2B84CF"/>
        <SolidColorBrush x:Key="PrimaryLight" Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"     Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"      Color="#5F7A93"/>
        <SolidColorBrush x:Key="InputBorder"  Color="#DCE8F3"/>
        <SolidColorBrush x:Key="InputBg"      Color="#F6FAFE"/>

        <!-- 입력칸 라벨 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3E5670"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- ===== TextBox ===== -->
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="bd"
                                Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B5D6F2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== PasswordBox ===== -->
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Margin" Value="0,0,0,14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="bd"
                                Background="{StaticResource InputBg}"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1" CornerRadius="12">
                            <ScrollViewer x:Name="PART_ContentHost"
                                          Margin="{TemplateBinding Padding}"
                                          VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="#B5D6F2"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                <Setter TargetName="bd" Property="Background" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== ComboBox (구분 선택) ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F7FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay,
                                                      RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource InputBorder}"
                                                BorderThickness="1" CornerRadius="12">
                                            <Path x:Name="arrow"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,14,0"
                                                  Data="M0,0 L5,5 L10,0"
                                                  Stroke="{StaticResource TextSub}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#B5D6F2"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                                <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource PrimaryBrush}"/>
                                                <Setter TargetName="arrow" Property="Data" Value="M0,5 L5,0 L10,5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="14,0,34,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom"
                                   AllowsTransparency="True"
                                   Focusable="False"
                                   PopupAnimation="Slide">
                                <Border Margin="0,6,0,10" Padding="4"
                                        Background="White"
                                        BorderBrush="{StaticResource InputBorder}"
                                        BorderThickness="1" CornerRadius="12"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 회원가입 완료 버튼 ===== -->
        <Style x:Key="PrimaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource PrimaryBrush}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B9BEA" BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource PrimaryDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="bd" Property="Background" Value="#B5D6F2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== 취소 버튼 (회색 외곽선) ===== -->
        <Style x:Key="SecondaryButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="#5F7A93"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="Transparent"
                                BorderBrush="{StaticResource InputBorder}"
                                BorderThickness="1" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F7FD"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="28,26,28,0">
            <!-- 타이틀 -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Border Width="48" Height="48" CornerRadius="16" Background="White" Margin="0,0,12,0">
                    <Border.Effect>
                        <DropShadowEffect Color="#3B9BEA" BlurRadius="16" ShadowDepth="2" Opacity="0.15"/>
                    </Border.Effect>
                    <TextBlock Text="🍱" FontSize="22"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="회원가입" FontSize="22" FontWeight="Bold" Foreground="{StaticResource TextMain}"/>
                    <TextBlock Text="정보를 입력하고 급식타그램을 시작하세요"
                               FontSize="12" Foreground="{StaticResource TextSub}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>

            <!-- 입력 카드 -->
            <Border Margin="0,24,0,0" Padding="24,24,24,22"
                    Background="White" CornerRadius="22">
                <Border.Effect>
                    <DropShadowEffect Color="#3B9BEA" BlurRadius="30" ShadowDepth="4" Opacity="0.12"/>
                </Border.Effect>

                <StackPanel>
                    <!-- 아이디 -->
                    <TextBlock Text="아이디" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtUsername"/>

                    <!-- 이름 (왼쪽 상단에 학교명과 함께 표시됨) -->
                    <TextBlock Text="이름" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtName" MaxLength="20"/>

                    <!-- 비밀번호 / 비밀번호 확인 (나란히) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="비밀번호" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="TxtPassword"/>
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="비밀번호 확인" Style="{StaticResource LabelStyle}"/>
                            <PasswordBox x:Name="TxtConfirmPassword"/>
                        </StackPanel>
                    </Grid>

                    <!-- 구분선 -->
                    <Border Height="1" Background="#E8F1F9" Margin="0,4,0,16"/>

                    <!-- 학교 이름 -->
                    <TextBlock Text="학교 이름" Style="{StaticResource LabelStyle}"/>
                    <TextBox x:Name="TxtSchoolName"/>

                    <!-- 구분 (학생 / 학부모 / 영양사) -->
                    <TextBlock Text="구분" Style="{StaticResource LabelStyle}"/>
                    <ComboBox x:Name="CboRole" SelectedIndex="0" Margin="0,0,0,24">
                        <ComboBoxItem Content="학생"/>
                        <ComboBoxItem Content="학부모"/>
                        <ComboBoxItem Content="영양사"/>
                    </ComboBox>

                    <!-- 회원가입 완료 (Enter 키로도 실행) -->
                    <Button x:Name="BtnRegisterSubmit"
                            Content="회원가입 완료"
                            IsDefault="True"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Click="BtnRegisterSubmit_Click"/>

                    <!-- 취소 (ESC 키로도 실행) -->
                    <Button x:Name="BtnCancel"
                            Content="취소"
                            IsCancel="True"
                            Margin="0,10,0,0"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Click="BtnCancel_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>
