<Window x:Class="중간프로젝트_클라이언트.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="급식타그램"
        Width="480" Height="740"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        FontFamily="Malgun Gothic">

    <!-- ===== 공통 하늘색 파스텔 배경 ===== -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#CFEBFF" Offset="0"/>
            <GradientStop Color="#EEF8FF" Offset="0.45"/>
            <GradientStop Color="#F6FBF4" Offset="1"/>
        </LinearGradientBrush>
    </Window.Background>

    <Window.Resources>
        <!-- ===== 공통 색상 (4개 창 동일) ===== -->
        <SolidColorBrush x:Key="Accent"      Color="#3B9BEA"/>
        <SolidColorBrush x:Key="AccentDark"  Color="#2B84CF"/>
        <SolidColorBrush x:Key="AccentLight" Color="#E1F1FD"/>
        <SolidColorBrush x:Key="TextMain"    Color="#22252E"/>
        <SolidColorBrush x:Key="TextSub"     Color="#5F7A93"/>
        <SolidColorBrush x:Key="LineBrush"   Color="#DCE8F3"/>
        <SolidColorBrush x:Key="InputBg"     Color="#F6FAFE"/>

        <!-- 메인 버튼 -->
        <Style x:Key="RoundedButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{StaticResource Accent}" CornerRadius="12">
                            <Border.Effect>
                                <DropShadowEffect Color="#3B9BEA" BlurRadius="14" ShadowDepth="3" Opacity="0.3"/>
                            </Border.Effect>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentDark}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="bd" Property="Opacity" Value="0.8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 글자만 있는 링크 버튼 (회원가입 / 돌아가기) -->
        <Style x:Key="LinkButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource Accent}"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="txt"
                                   Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   Background="Transparent"
                                   Padding="6,4"
                                   HorizontalAlignment="Center"/>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="txt" Property="TextDecorations" Value="Underline"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 입력칸 테두리 : 안에 커서가 있으면 하늘색 강조 -->
        <Style x:Key="InputBorderStyle" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource InputBg}"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Padding" Value="14,0"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#B5D6F2"/>
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Background" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- 입력칸 라벨 -->
        <Style x:Key="LabelStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#3E5670"/>
            <Setter Property="Margin" Value="2,0,0,6"/>
        </Style>

        <!-- 테두리 안 TextBox / PasswordBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- ===== 사용자 유형 ComboBox ===== -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="bd" Background="Transparent" CornerRadius="8" Padding="12,9">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#F0F7FD"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="{StaticResource AccentLight}"/>
                                <Setter Property="Foreground" Value="{StaticResource AccentDark}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Height" Value="48"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Foreground" Value="{StaticResource TextMain}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="bd"
                                                Background="{StaticResource InputBg}"
                                                BorderBrush="{StaticResource LineBrush}"
                                                BorderThickness="1" CornerRadius="12">
                                            <Path x:Name="arrow"
                                                  HorizontalAlignment="Right" VerticalAlignment="Center"
                                                  Margin="0,0,16,0"
                                                  Data="M0,0 L5,5 L10,0"
                                                  Stroke="{StaticResource TextSub}" StrokeThickness="1.8"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="#B5D6F2"/>
                                            </Trigger>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="bd" Property="BorderBrush" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="bd" Property="BorderThickness" Value="2"/>
                                                <Setter TargetName="bd" Property="Background" Value="White"/>
                                                <Setter TargetName="arrow" Property="Stroke" Value="{StaticResource Accent}"/>
                                                <Setter TargetName="arrow" Property="Data" Value="M0,5 L5,0 L10,5"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <ContentPresenter IsHitTestVisible="False"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="16,0,36,0"
                                              HorizontalAlignment="Left" VerticalAlignment="Center"/>

                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True"
                                   Focusable="False" PopupAnimation="Slide">
                                <Border Margin="0,6,0,10" Padding="4"
                                        Background="White"
                                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                                        CornerRadius="12"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.12"/>
                                    </Border.Effect>
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="30,24">
        <Border Background="White"
                CornerRadius="26"
                Padding="34,30"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#3B9BEA" BlurRadius="30" ShadowDepth="4" Opacity="0.12"/>
            </Border.Effect>

            <Grid>
                <!-- ================= 로그인 패널 ================= -->
                <StackPanel x:Name="LoginPanel"
                            Visibility="Visible"
                            VerticalAlignment="Center">

                    <Border Width="78" Height="78"
                            Background="{StaticResource AccentLight}"
                            CornerRadius="24"
                            HorizontalAlignment="Center"
                            Margin="0,0,0,18">
                        <TextBlock Text="🍚" FontSize="40"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>

                    <TextBlock Text="급식타그램"
                               FontSize="27" FontWeight="Bold"
                               Foreground="{StaticResource TextMain}"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="우리 학교 오늘의 급식을 만나보세요"
                               FontSize="13"
                               Foreground="{StaticResource TextSub}"
                               HorizontalAlignment="Center"
                               Margin="0,8,0,30"/>

                    <TextBlock Text="아이디" Style="{StaticResource LabelStyle}"/>
                    <Border Style="{StaticResource InputBorderStyle}">
                        <TextBox x:Name="TxtLoginId" FontSize="15"/>
                    </Border>

                    <TextBlock Text="비밀번호" Style="{StaticResource LabelStyle}" Margin="2,2,0,6"/>
                    <Border Style="{StaticResource InputBorderStyle}" Margin="0,0,0,24">
                        <PasswordBox x:Name="TxtLoginPwd" FontSize="15"/>
                    </Border>

                    <Button Content="로그인"
                            Style="{StaticResource RoundedButtonStyle}"
                            Height="50" FontSize="16"
                            IsDefault="True"
                            Click="BtnLogin_Click"/>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,20,0,0">
                        <TextBlock Text="아직 회원이 아니신가요?"
                                   Foreground="{StaticResource TextSub}"
                                   VerticalAlignment="Center"
                                   FontSize="12"/>
                        <Button Content="회원가입"
                                Style="{StaticResource LinkButtonStyle}"
                                FontSize="12"
                                VerticalAlignment="Center"
                                Click="BtnRegister_Click"/>
                    </StackPanel>
                </StackPanel>

                <!-- ================= 회원가입 패널 ================= -->
                
            </Grid>
        </Border>
    </Grid>
</Window>
